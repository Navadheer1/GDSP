rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny access by default to any unmapped root collection
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile document: only the authenticated user can read or modify their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // History subcollection: users/{userId}/history/{historyId}
      // Strict access control: only the owning user has access
      match /history/{historyId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Writer Documents subcollection: users/{userId}/documents/{documentId}
      // Strict access control: only the owning user can read, create, update, or delete
      match /documents/{documentId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
